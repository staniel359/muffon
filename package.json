{
  "name": "muffon",
  "desktopName": "com.electron.muffon",
  "version": "2.5.0",
  "description": "Advanced multi-source music streaming + discovery client",
  "homepage": "https://muffon.netlify.app",
  "repository": "https://github.com/staniel359/muffon",
  "license": "AGPL-3.0",
  "author": {
    "name": "Aleksey Shpakovsky",
    "email": "staniel359@gmail.com",
    "url": "https://github.com/staniel359"
  },
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start:vue": "vite",
    "start:electron": "electron . --disable-gpu",
    "lint": "eslint ./src ./electron",
    "build:vue": "vite build",
    "build:electron": "electron-builder --dir",
    "build": "pnpm build:vue && pnpm build:electron",
    "package:electron": "electron-builder",
    "package": "pnpm build:vue && pnpm package:electron",
    "release:electron": "pnpm package:electron --publish always",
    "release": "pnpm build:vue && pnpm release:electron",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "electron-dl": "^5.0.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "i18n": "^0.15.4",
    "music-metadata": "^12.2.3",
    "sanitize-html": "^2.18.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-inject": "^5.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "axios": "^1.20.0",
    "change-case": "^5.4.4",
    "crypto-js": "^4.2.0",
    "deepmerge": "^4.3.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-vue": "^10.11.1",
    "fomantic-ui": "^2.9.4",
    "globals": "^17.13.0",
    "hotkeys-js": "^4.0.8",
    "i18n-iso-countries": "^7.14.0",
    "jquery": "^4.0.0",
    "pinia": "^4.1.0",
    "sass": "^1.106.1",
    "slick-carousel": "^2.0.0",
    "uint8array-extras": "^1.6.0",
    "vite": "^8.3.5",
    "vite-plugin-eslint": "^1.8.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "packageManager": "pnpm@12.15.0"
}
